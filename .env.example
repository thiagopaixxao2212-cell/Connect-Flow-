# EXEMPLO APENAS — NUNCA COLOQUE SEGREDOS REAIS NO GITHUB.

# Supabase (frontend pode usar somente a chave publishable/anon)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxx

# Backend / Supabase Edge Functions — configure como secrets no Supabase
SUPABASE_SERVICE_ROLE_KEY=COLOQUE_COMO_SECRET_NO_SUPABASE
OPENAI_API_KEY=COLOQUE_COMO_SECRET_NO_SUPABASE

# E-mail transacional / SMTP — NÃO commitar valores reais
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=seu-email@gmail.com
SMTP_PASSWORD=SENHA_DE_APP_COMO_SECRET
SMTP_FROM_NAME=ConnectFlow Digital

# Meta Ads — tokens devem permanecer no Vault/Secrets do backend
META_ACCESS_TOKEN=NAO_COMMITAR
